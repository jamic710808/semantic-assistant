<Window x:Class="SemanticAssistant.Desktop.TemplatesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="範本 · 報告風格" Width="780" Height="770" MinWidth="720" MinHeight="680"
 WindowStartupLocation="CenterOwner" Background="#F4EDF7" FontFamily="Microsoft JhengHei UI" FontSize="12">
 <Window.Resources>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Padding" Value="16,7"/><Setter Property="Background" Value="#007ED8"/><Setter Property="Foreground" Value="White"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Tab" TargetType="Button" BasedOn="{StaticResource Action}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#5D718D"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style x:Key="Swatch" TargetType="Button"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.7"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Border Margin="11" Background="#F8F8FD" CornerRadius="15" Padding="18">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="範本" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,16"/>
   <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,15">
    <Button x:Name="MeasureTab" Content="報告度量值範本" Tag="0" Style="{StaticResource Tab}" Click="OnTab"/>
    <Button x:Name="FileTab" Content="獨立 HTML 範本" Tag="1" Style="{StaticResource Tab}" Click="OnTab"/>
    <Button x:Name="DashboardTab" Content="Dashboard 範本" Tag="2" Style="{StaticResource Tab}" Click="OnTab"/>
   </StackPanel>
   <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
    <StackPanel>
     <TextBlock x:Name="PageTitle" FontWeight="SemiBold" FontSize="16"/>
     <TextBlock x:Name="PageHint" Foreground="#6D7F96" TextWrapping="Wrap" Margin="0,6,0,14"/>
     <Border CornerRadius="11" BorderBrush="#DFE5F0" BorderThickness="1" Padding="14" Background="#F5F8FC" Margin="0,0,0,12">
      <StackPanel><TextBlock Text="版型"/><ComboBox x:Name="TemplatePicker" DisplayMemberPath="Name" Padding="10,8" Margin="0,7,0,7" SelectionChanged="OnTemplateChanged"/><TextBlock x:Name="DescriptionText" Foreground="#61758C" FontSize="11" TextWrapping="Wrap"/></StackPanel>
     </Border>
     <Border CornerRadius="11" BorderBrush="#DFE5F0" BorderThickness="1" Padding="14" Background="#F5F8FC" Margin="0,0,0,12">
      <StackPanel><TextBlock Text="配色方案" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,10"/><WrapPanel x:Name="PalettePanel"/></StackPanel>
     </Border>
     <TextBlock Text="布局預覽 · 合成示範資料" Foreground="#61758C" FontSize="11" Margin="0,0,0,7"/>
     <Border x:Name="PreviewSurface" CornerRadius="11" Padding="10"><StackPanel><TextBlock x:Name="PreviewTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,7"/><Grid x:Name="PreviewLayout"/></StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <DockPanel Grid.Row="3" Margin="0,10,0,0"><Button DockPanel.Dock="Right" Content="開啟完整 HTML 預覽" Style="{StaticResource Action}" Click="OnPreview"/><TextBlock Text="預覽使用自有輸出器；不查詢 Power BI 或 AI。" FontSize="11" Foreground="#6D7F96" VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="4" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="按保存套用三頁設定；取消會捨棄本次修改。" TextWrapping="Wrap" Foreground="#6D7F96" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <Button Grid.Column="1" Content="取消" Style="{StaticResource Action}" Background="#73849A" Click="OnCancel" Margin="0,0,10,0"/>
    <Button Grid.Column="2" Content="保存" Style="{StaticResource Action}" Click="OnSave"/>
   </Grid>
  </Grid>
 </Border>
</Window>
