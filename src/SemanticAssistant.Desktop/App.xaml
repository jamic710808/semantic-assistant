<Application x:Class="SemanticAssistant.Desktop.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
 <Application.Resources>
  <Style TargetType="{x:Type Window}"><Setter Property="Icon" Value="pack://application:,,,/SemanticAssistant.Desktop;component/Assets/SemanticAssistant.ico"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="0,0,8,0"/></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
 </Application.Resources>
</Application>
