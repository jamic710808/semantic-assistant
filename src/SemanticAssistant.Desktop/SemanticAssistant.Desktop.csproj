<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets/SemanticAssistant.ico</ApplicationIcon>
    <Version>1.0.1-dev.20261015</Version>
    <AssemblyVersion>1.0.1.0</AssemblyVersion>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <BuildUtc Condition="'$(BuildUtc)' == ''">$([System.DateTime]::UtcNow.ToString('O'))</BuildUtc>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyMetadata Include="BuildUtc" Value="$(BuildUtc)" />
    <AssemblyMetadata Include="ReleaseChannel" Value="Development" />
  </ItemGroup>
  <ItemGroup>
    <None Remove="Assets/SemanticAssistant.ico" />
    <Resource Include="Assets/SemanticAssistant.ico" />
    <Content Include="Assets/SemanticAssistant.ico">
      <Link>SemanticAssistant.ico</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.3.2" />
    <Content Include="../../third-party/Markdig.LICENSE.txt">
      <Link>Markdig.LICENSE.txt</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup><ProjectReference Include="../SemanticAssistant.Adapters.Demo/SemanticAssistant.Adapters.Demo.csproj" /></ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SemanticAssistant.Cli/SemanticAssistant.Cli.csproj" ReferenceOutputAssembly="false" />
    <Content Include="../SemanticAssistant.Cli/bin/$(Configuration)/net10.0/SemanticAssistant.Cli.dll;../SemanticAssistant.Cli/bin/$(Configuration)/net10.0/SemanticAssistant.Cli.deps.json;../SemanticAssistant.Cli/bin/$(Configuration)/net10.0/SemanticAssistant.Cli.runtimeconfig.json">
      <Link>%(Filename)%(Extension)</Link><CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory><CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../SemanticAssistant.Adapters.Mcp/SemanticAssistant.Adapters.Mcp.csproj" />
    <ProjectReference Include="../SemanticAssistant.Adapters.AI/SemanticAssistant.Adapters.AI.csproj" />
    <ProjectReference Include="../SemanticAssistant.Adapters.PowerBI.Local/SemanticAssistant.Adapters.PowerBI.Local.csproj" />
    <ProjectReference Include="../SemanticAssistant.Adapters.PowerBI.Cloud/SemanticAssistant.Adapters.PowerBI.Cloud.csproj" />
    <ProjectReference Include="../SemanticAssistant.Adapters.PowerBI.Files/SemanticAssistant.Adapters.PowerBI.Files.csproj" />
    <Content Include="../../examples/synthetic-model/definition/**/*.tmdl">
      <Link>Examples/definition/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
