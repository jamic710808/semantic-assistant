<Window x:Class="SemanticAssistant.Desktop.QuickQuestionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="提問配置" Width="490" Height="470" MinWidth="470" MinHeight="450" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft JhengHei UI" FontSize="12">
 <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F8EAF4" Offset="0"/><GradientStop Color="#E8EEFF" Offset="1"/></LinearGradientBrush></Window.Background>
 <Window.Resources>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Padding" Value="15,7"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#007ED8"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderThickness" Value="0"/><Setter Property="BorderBrush" Value="#DCE4F0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="15" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Opacity" Value="0.75"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Field" TargetType="TextBox">
   <Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="#DCE4F0"/><Setter Property="Height" Value="34"/>
   <Setter Property="Padding" Value="10,3"/><Setter Property="Margin" Value="0,7,0,11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#1684D6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="13" Background="#F8F8FD" CornerRadius="15" Padding="16">
  <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <TextBlock Text="提問配置" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
   <StackPanel Grid.Row="1">
    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
     <TextBlock Text="提問類型" Foreground="#7A808D" VerticalAlignment="Center" Margin="0,0,12,0"/>
     <Button x:Name="LocalButton" Content="本地" Tag="local" Style="{StaticResource Action}" Click="OnMode" Margin="0,0,8,0"/>
     <Button x:Name="CloudButton" Content="雲端" Tag="cloud" Style="{StaticResource Action}" Click="OnMode"/>
    </StackPanel>
    <TextBlock x:Name="ModeHint" Foreground="#7A808D" Margin="0,0,0,15"/>
    <TextBlock Text="問題 1"/><TextBox x:Name="Question1" Style="{StaticResource Field}" MaxLength="1000" AutomationProperties.Name="快捷問題1"/>
    <TextBlock Text="問題 2"/><TextBox x:Name="Question2" Style="{StaticResource Field}" MaxLength="1000" AutomationProperties.Name="快捷問題2"/>
    <TextBlock Text="問題 3"/><TextBox x:Name="Question3" Style="{StaticResource Field}" MaxLength="1000" AutomationProperties.Name="快捷問題3"/>
   </StackPanel>
   <Grid Grid.Row="2" Margin="0,8,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusText" Text="保存後套用至首頁；空白使用預設問題。" Foreground="#7A808D" FontSize="10" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,10,0"/>
    <Button Grid.Column="1" Content="取消" Style="{StaticResource Action}" Background="#E9EBF3" Foreground="#58667B" Click="OnCancel" Margin="0,0,8,0"/>
    <Button Grid.Column="2" Content="保存" Style="{StaticResource Action}" Click="OnSave"/>
   </Grid>
  </Grid>
 </Border>
</Window>
