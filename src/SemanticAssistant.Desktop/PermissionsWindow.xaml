<Window x:Class="SemanticAssistant.Desktop.PermissionsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="權限管理" Width="380" Height="250" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
 FontFamily="Microsoft JhengHei UI" FontSize="13">
 <Window.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#F8EAF5" Offset="0"/><GradientStop Color="#E8EDFF" Offset="1"/></LinearGradientBrush></Window.Background>
 <Grid Margin="17,17,17,19">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <TextBlock Text="權限管理" FontSize="18" Margin="0,0,0,21"/>
  <StackPanel Grid.Row="1">
   <CheckBox x:Name="AllowModification" Content="允許 Semantic 智能助手修改資料模型"/>
   <TextBlock x:Name="HintText" Text="勾選後，本助手可以修改資料模型。取消勾選，進入安全模式，本助手僅提供代碼或建議，無法直接修改模型。" TextWrapping="Wrap" FontSize="11" Foreground="#9799AA" Margin="19,9,0,0"/>
  </StackPanel>
  <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
   <Button Content="取消" Width="80" Height="30" Margin="0,0,10,0" Background="#DADADA" Click="OnCancel"/>
   <Button Content="保存" Width="80" Height="30" Background="#007ED8" Foreground="White" BorderBrush="#007ED8" Click="OnSave"/>
  </StackPanel>
 </Grid>
</Window>
