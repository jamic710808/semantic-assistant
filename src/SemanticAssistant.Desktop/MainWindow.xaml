<Window x:Class="SemanticAssistant.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SemanticAssistant.Desktop"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="Semantic 智能助手" Width="998" Height="646" MinWidth="940" MinHeight="600"
 WindowStyle="None" ResizeMode="CanResize" FontFamily="Microsoft JhengHei UI" FontSize="12"
 Foreground="#252A32" Closing="OnClosing" WindowStartupLocation="CenterScreen">
 <shell:WindowChrome.WindowChrome>
  <shell:WindowChrome CaptionHeight="46" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False"/>
 </shell:WindowChrome.WindowChrome>
 <Window.Background>
  <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.8">
   <GradientStop Color="#FAE7F3" Offset="0"/><GradientStop Color="#E8EFFF" Offset="0.64"/><GradientStop Color="#EEE7F6" Offset="1"/>
  </LinearGradientBrush>
 </Window.Background>
 <Window.Resources>
  <SolidColorBrush x:Key="MutedText" Color="#737A88"/>
  <Style x:Key="SoftButton" TargetType="Button">
   <Setter Property="Background" Value="#EAE8F0"/><Setter Property="Foreground" Value="#263A52"/>
   <Setter Property="Padding" Value="13,5"/><Setter Property="Margin" Value="0"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="HorizontalContentAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="16" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#E0DFEE"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#007FD8"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.42"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="TextButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
   <Setter Property="Background" Value="Transparent"/><Setter Property="Padding" Value="7,7"/>
  </Style>
  <Style x:Key="PanelButton" TargetType="Button" BasedOn="{StaticResource SoftButton}">
   <Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="Margin" Value="0,0,0,7"/><Setter Property="Padding" Value="12,9"/>
  </Style>
  <Style x:Key="QuickPrompt" TargetType="Button" BasedOn="{StaticResource SoftButton}">
   <Setter Property="ToolTip" Value="將提示詞填入下方輸入框，再按送出開始分析"/>
   <Setter Property="Foreground" Value="#7B7B84"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="Padding" Value="11,6"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,0,9,8"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid>
     <Rectangle x:Name="Outline" RadiusX="15" RadiusY="15" Stroke="#BEC2CB" StrokeDashArray="2,2" Fill="{TemplateBinding Background}"/>
     <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Outline" Property="Fill" Value="#EEEFFA"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Outline" Property="Stroke" Value="#007FD8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="ModeChip" TargetType="ToggleButton">
   <Setter Property="Background" Value="#F6F7FB"/><Setter Property="Foreground" Value="#365273"/>
   <Setter Property="FontSize" Value="11"/><Setter Property="Padding" Value="15,4"/><Setter Property="Margin" Value="0,0,8,0"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="Chip" Background="{TemplateBinding Background}" BorderBrush="#DADEE9" BorderThickness="1" CornerRadius="13" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Chip" Property="Background" Value="#E6F1FE"/><Setter TargetName="Chip" Property="BorderBrush" Value="#82B8EC"/><Setter Property="Foreground" Value="#006CB8"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#97AFC8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chip" Property="BorderBrush" Value="#007FD8"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chip" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SendCircle" TargetType="Button" BasedOn="{StaticResource SoftButton}">
   <Setter Property="Background" Value="#0081D9"/><Setter Property="Width" Value="31"/><Setter Property="Height" Value="31"/>
   <Setter Property="Padding" Value="0"/><Setter Property="ToolTip" Value="{Binding Content, RelativeSource={RelativeSource Self}}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Grid><Ellipse x:Name="Circle" Fill="{TemplateBinding Background}"/>
     <Path Data="M 9,9 L 23,15.5 L 9,22 L 12,15.5 Z M 12,15.5 L 21,15.5" Fill="White" Stroke="White" StrokeThickness="0.8"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Circle" Property="Fill" Value="#006CBE"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Circle" Property="Stroke" Value="#245077"/><Setter TargetName="Circle" Property="StrokeThickness" Value="2"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SceneTabs" TargetType="TabControl">
   <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabControl">
    <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TreeViewItem">
   <Setter Property="Foreground" Value="#292B32"/><Setter Property="FontSize" Value="12"/><Setter Property="Padding" Value="1,2"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="56"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Margin="18,0,9,0">
   <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,21,0">
    <TextBlock Text="Semantic 智能助手" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
    <Border Width="1" Height="16" Background="#D2CBD8" Margin="11,0,10,0"/>
    <Grid Width="21" Height="21" ToolTip="開源語意模型助理">
     <Ellipse Stroke="#617D9A" StrokeThickness="1.3"/>
     <Path Data="M 6,13 L 6,10 M 10,13 L 10,8 M 14,13 L 14,6" Stroke="#537698" StrokeThickness="2"/>
    </Grid>
   </StackPanel>
   <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="LocalButton" Content="連接本地報告" Click="OnOpenLocal" Style="{StaticResource SoftButton}" Background="#D9D2DF" Margin="0,0,13,0"/>
    <Button x:Name="CloudButton" Content="雲端語意模型" Click="OnOpenCloud" Style="{StaticResource SoftButton}" Background="#D9D2DF"/>
   </StackPanel>
   <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0,15,0" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button x:Name="AiConfigButton" Content="AI 配置" Click="OnAiConfig" Style="{StaticResource TextButton}"/>
    <Button x:Name="TemplatesButton" Content="範本" Click="OnShowTemplates" Style="{StaticResource TextButton}"/>
    <Button x:Name="PermissionsButton" Content="權限管理" Click="OnShowPermissions" Style="{StaticResource TextButton}"/>
    <Button x:Name="GuideButton" Content="引導式提問" Click="OnShowGuide" Style="{StaticResource TextButton}"/>
    <Button Content="語言" Click="OnShowLanguage" Style="{StaticResource TextButton}"/>
    <Button Content="關於" Click="OnShowAbout" Style="{StaticResource TextButton}"/>
   </StackPanel>
   <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" shell:WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="─" Width="40" Height="44" Click="OnMinimize" Style="{StaticResource TextButton}" AutomationProperties.Name="最小化"/>
    <Button Content="□" Width="40" Height="44" Click="OnMaximizeRestore" Style="{StaticResource TextButton}" AutomationProperties.Name="最大化或還原"/>
    <Button Content="×" Width="40" Height="44" FontSize="18" Click="OnWindowClose" Style="{StaticResource TextButton}" AutomationProperties.Name="關閉"/>
   </StackPanel>
  </Grid>
  <Border Grid.Row="1" Margin="18,2,18,18" CornerRadius="18" ClipToBounds="True">
   <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F4F7FD" Offset="0"/><GradientStop Color="#F8F3FA" Offset="1"/></LinearGradientBrush></Border.Background>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="249"/><ColumnDefinition Width="1"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border CornerRadius="18,0,0,18" Background="#F7F5FA">
     <Grid Margin="21,21,20,14">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="模型結構" FontWeight="Bold" FontSize="14" Margin="0,0,0,11"/>
      <Border Grid.Row="1" Background="#E8E6EB" CornerRadius="15" Height="31" Margin="0,0,0,18">
       <Grid Margin="11,0,10,0"><Grid.ColumnDefinitions><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Path Data="M 11,8 A 4.5,4.5 0 1 1 2,8 A 4.5,4.5 0 1 1 11,8 M 3.5,11.5 L 0,15" Stroke="#9E9DA5" StrokeThickness="1.2" VerticalAlignment="Center" Height="18"/>
        <TextBox x:Name="SearchInput" Grid.Column="1" Background="Transparent" BorderThickness="0" Padding="0" VerticalContentAlignment="Center" MaxLength="200" TextChanged="OnSearchChanged" AutomationProperties.Name="搜尋模型物件"/>
        <TextBlock Grid.Column="1" Text="搜尋模型…" Foreground="#9D9BA3" VerticalAlignment="Center" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=SearchInput}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
      </Border>
      <TreeView x:Name="ModelTree" Grid.Row="2" Background="Transparent" BorderThickness="0" SelectedItemChanged="OnMetadataSelected" ScrollViewer.HorizontalScrollBarVisibility="Auto"/>
      <StackPanel Grid.Row="3" Margin="0,12,0,0">
       <TextBlock x:Name="ModelCounts" Visibility="Collapsed"/>
       <TextBlock x:Name="AiProviderLabel" Text="AI：本機模擬" Foreground="#94939F" FontSize="10" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
       <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
        <Button Content="來源與工具" Click="OnShowTools" Style="{StaticResource TextButton}" FontSize="10" Padding="0,4,10,4"/>
        <Button Content="查詢結果" Click="OnShowResults" Style="{StaticResource TextButton}" FontSize="10" Padding="0,4"/>
       </StackPanel>
      </StackPanel>
     </Grid>
    </Border>
    <Border Grid.Column="1" Background="#D9D6DF"/>
    <Grid Grid.Column="2">
     <Grid.RowDefinitions><RowDefinition Height="113"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel Margin="25,55,25,0" HorizontalAlignment="Center" MaxWidth="650">
      <TextBlock x:Name="SourceStatus" Foreground="#1BC64D" FontSize="11" TextAlignment="Center" TextWrapping="Wrap"/>
      <TextBlock x:Name="ModelName" Foreground="#1BC64D" FontSize="11" TextAlignment="Center" Margin="0,12,0,0"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,7,30,0">
      <Button x:Name="BackToChatButton" Content="返回對話" Click="OnBackToChat" Style="{StaticResource TextButton}" Visibility="Collapsed" FontSize="11"/>
      <Border Background="#EFE9F5" CornerRadius="16" BorderBrush="#E5DFEC" BorderThickness="1">
       <StackPanel Orientation="Horizontal">
        <Button x:Name="NewConversationButton" Content="+" Click="OnNewConversation" FontSize="18" Width="28" Height="28" Padding="0" Style="{StaticResource TextButton}" ToolTip="開始新對話，清除當次結果與授權" AutomationProperties.Name="開始新對話"/>
        <Button x:Name="HistoryButton" Content="◴" Click="OnHistory" Width="28" Height="28" Padding="0" Style="{StaticResource TextButton}" ToolTip="本機歷史紀錄" AutomationProperties.Name="歷史紀錄"/>
       </StackPanel>
      </Border>
     </StackPanel>
     <TabControl x:Name="ContentTabs" Grid.Row="1" Style="{StaticResource SceneTabs}" SelectionChanged="OnSceneChanged">
      <TabItem Header="對話" x:Name="ChatTab">
       <Grid Margin="48,14,36,0">
        <StackPanel x:Name="WelcomePanel">
         <TextBlock x:Name="WelcomeText" Text="我是你的 Semantic 智能助手，你可以向我提出模型分析需求～" Foreground="#717889" FontSize="13" Margin="0,5,0,35"/>
         <WrapPanel x:Name="QuickPrompts">
          <Button x:Name="QuickQuestionButton1" Tag="0" Click="OnQuickPrompt" Style="{StaticResource QuickPrompt}"/>
          <Button x:Name="QuickQuestionButton2" Tag="1" Click="OnQuickPrompt" Style="{StaticResource QuickPrompt}"/>
          <Button x:Name="QuickQuestionButton3" Tag="2" Click="OnQuickPrompt" Style="{StaticResource QuickPrompt}"/>
         </WrapPanel>
        </StackPanel>
        <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Visibility="Collapsed">
         <StackPanel>
          <local:MarkdownConversationView x:Name="Transcript" MinWidth="0"
                   AutomationProperties.Name="對話內容，可選取並複製"/>
          <WrapPanel Margin="0,12,0,0">
           <Button x:Name="CopyAnswerButton" Content="複製最新回答" Click="OnCopyAnswer" Style="{StaticResource SoftButton}" IsEnabled="False" Margin="0,0,10,0"/>
           <Button x:Name="CopyConversationButton" Content="複製全部對話" Click="OnCopyConversation" Style="{StaticResource SoftButton}" IsEnabled="False" Margin="0,0,10,0"/>
           <Button x:Name="ReportArtifactButton" Content="匯出／開啟 HTML 報告" Click="OnExport" Style="{StaticResource SoftButton}" Visibility="Collapsed" Margin="0,0,10,0"/>
           <Button x:Name="DashboardArtifactButton" Content="檢視 Dashboard 計畫" Click="OnOpenDashboardProposal" Style="{StaticResource SoftButton}" Visibility="Collapsed"/>
           <Button x:Name="AiModificationArtifactButton" Content="檢視 AI 模型修改" Click="OnReviewAiWrite" Style="{StaticResource SoftButton}" Visibility="Collapsed" Margin="8,0,0,0"/>
          </WrapPanel>
         </StackPanel>
        </ScrollViewer>
       </Grid>
      </TabItem>
      <TabItem Header="模型詳情">
       <Grid Margin="38,16,38,12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <TextBlock x:Name="DetailTitle" FontSize="17" FontWeight="Bold" Margin="0,0,0,15"/>
        <TextBox x:Name="MetadataDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" Background="Transparent" BorderThickness="0" VerticalScrollBarVisibility="Auto" FontSize="13" Padding="0"/>
       </Grid>
      </TabItem>
     </TabControl>
     <Border Grid.Row="2" Background="White" CornerRadius="19" Margin="35,12,30,21" Padding="11,9,10,5" MinHeight="64">
      <Border.Effect><DropShadowEffect Color="#8E91A1" BlurRadius="14" ShadowDepth="3" Opacity="0.15"/></Border.Effect>
      <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <Grid Margin="5,0,8,2">
        <TextBox x:Name="MessageInput" Background="Transparent" BorderThickness="0" Padding="0" FontSize="13" MaxLength="4000" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="110" MinHeight="18" VerticalScrollBarVisibility="Auto" PreviewKeyDown="OnMessageKeyDown" TextChanged="OnMessageChanged" AutomationProperties.Name="輸入模型分析需求"/>
        <TextBlock Text="輸入需求，或選擇上方的快捷提問…" Foreground="#B2B3BC" FontSize="12" IsHitTestVisible="False">
         <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding Text, ElementName=MessageInput}" Value=""/><Condition Binding="{Binding IsKeyboardFocusWithin, ElementName=MessageInput}" Value="False"/></MultiDataTrigger.Conditions><Setter Property="Visibility" Value="Visible"/></MultiDataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
       </Grid>
       <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Bottom">
        <ToggleButton x:Name="ReportModeButton" Content="報告模式" Tag="1" Click="OnModeChip" Style="{StaticResource ModeChip}"/>
        <ToggleButton x:Name="HtmlModeButton" Content="HTML 模式" Tag="2" Click="OnModeChip" Style="{StaticResource ModeChip}" ToolTip="輸入需求產生報告正文，另行同意後匯出 HTML；來源與工具可切換 HTML 度量值"/>
        <ToggleButton x:Name="DashboardModeButton" Content="Dashboard" Tag="4" Click="OnModeChip" Style="{StaticResource ModeChip}"/>
        <Button x:Name="AnalyzeModeButton" Content="分析" Click="OnAnalyzeMode" Style="{StaticResource TextButton}" Padding="4,3" FontSize="10" ToolTip="回到結構與分析模式"/>
       </StackPanel>
       <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Center">
        <Button x:Name="CancelButton" Content="取消" Click="OnCancel" Style="{StaticResource TextButton}" Visibility="Collapsed" IsEnabled="False" FontSize="11" Padding="5"/>
        <Button x:Name="AttachmentButton" Click="OnOpenFolder" Style="{StaticResource TextButton}" Margin="0,0,10,0" ToolTip="開啟 TMDL 模型資料夾" AutomationProperties.Name="開啟 TMDL 資料夾">
         <Button.Template><ControlTemplate TargetType="Button"><Grid Width="18" Height="25"><Path Data="M 12,6 L 12,17 C 12,22 5,22 5,17 L 5,7 C 5,2 10,2 10,7 L 10,17 C 10,20 7,20 7,17 L 7,8" Stroke="#96939B" StrokeThickness="1.1"/><Grid.Style><Style TargetType="Grid"><Style.Triggers><DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource TemplatedParent}}" Value="False"><Setter Property="Opacity" Value="0.4"/></DataTrigger></Style.Triggers></Style></Grid.Style></Grid></ControlTemplate></Button.Template>
        </Button>
        <Button x:Name="SendButton" Content="送出" Click="OnSend" Style="{StaticResource SendCircle}" AutomationProperties.Name="送出目前操作"/>
       </StackPanel>
      </Grid>
     </Border>
    </Grid>
    <Border x:Name="UtilityPanel" Grid.Column="2" Width="335" HorizontalAlignment="Right" Background="#FEFDFF" CornerRadius="16" Margin="8" Padding="16" Visibility="Collapsed" Panel.ZIndex="5">
     <Border.Effect><DropShadowEffect Color="#827A97" BlurRadius="20" ShadowDepth="0" Opacity="0.18"/></Border.Effect>
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,12"><Button DockPanel.Dock="Right" Content="×" Click="OnCloseUtility" Style="{StaticResource TextButton}" FontSize="18" AutomationProperties.Name="關閉側面板"/><TextBlock x:Name="UtilityTitle" Text="權限與工具" FontSize="16" FontWeight="Bold" VerticalAlignment="Center"/></DockPanel>
      <TabControl x:Name="UtilityTabs" Grid.Row="1" BorderThickness="0" Background="Transparent">
       <TabItem Header="執行設定"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,16,4,0">
        <TextBlock Text="當次操作與執行設定" FontWeight="Bold" Margin="0,0,0,16"/>
        <CheckBox x:Name="AllowQuery" Content="允許目前模型數值查詢" Margin="0,0,0,14"/>
        <CheckBox x:Name="AllowExport" Content="允許匯出本機 HTML" Margin="0,0,0,14"/>
        <CheckBox x:Name="AllowExternalTools" Content="允許 AI 提出已匯入工具呼叫" ToolTip="每次執行仍需預覽參數與明確同意" Margin="0,0,0,14"/>
        <TextBlock x:Name="PolicyHint" Foreground="{StaticResource MutedText}" FontSize="12" Margin="0,0,0,18"/>
        <Button x:Name="SettingsButton" Content="本機執行預算" Click="OnSettings" Style="{StaticResource PanelButton}"/>
        <Button x:Name="AiDemoButton" Content="使用本機模擬 AI" Click="OnAiDemo" Style="{StaticResource PanelButton}"/>
       </StackPanel></ScrollViewer></TabItem>
       <TabItem Header="來源與工具"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,16,4,0">
        <Button x:Name="OpenFolderButton" Content="開啟 TMDL 資料夾" Click="OnOpenFolder" Style="{StaticResource PanelButton}"/>
        <Button x:Name="OpenExampleButton" Content="載入內附範例" Click="OnOpenExample" Style="{StaticResource PanelButton}"/>
        <Button x:Name="ReloadButton" Content="重新讀取目前模型" Click="OnReload" IsEnabled="False" Style="{StaticResource PanelButton}"/>
        <Button x:Name="DemoButton" Content="返回合成示範" Click="OnReturnToDemo" Style="{StaticResource PanelButton}"/>
        <Button x:Name="CloudSignOutButton" Content="登出雲端並清除本機登入" Click="OnSignOutCloud" IsEnabled="False" Style="{StaticResource PanelButton}"/>
        <TextBlock Text="外部工具與模型設計" FontWeight="Bold" Margin="0,12,0,12"/>
        <Button x:Name="McpButton" Content="MCP 外部工具" Click="OnOpenMcp" Style="{StaticResource PanelButton}"/>
        <TextBlock x:Name="ImportedToolsLabel" Text="已明確匯入：0 個外部工具" FontSize="11" Foreground="{StaticResource MutedText}" Margin="0,0,0,9"/>
        <Button x:Name="ClearImportsButton" Content="清除已匯入工具並關閉程序" Click="OnClearImportedTools" Style="{StaticResource PanelButton}"/>
        <Button x:Name="WriteButton" Content="模型修改預覽" Click="OnOpenWriter" Style="{StaticResource PanelButton}"/>
        <Button x:Name="DashboardButton" Content="Dashboard 計畫" Click="OnOpenDashboard" Style="{StaticResource PanelButton}"/>
        <Button x:Name="DeployedDashboardsButton" Content="已部署 Dashboard" Click="OnDeployedDashboards" Style="{StaticResource PanelButton}"/>
        <TextBlock Text="完整操作模式" Foreground="{StaticResource MutedText}" Margin="0,10,0,6"/>
        <ComboBox x:Name="ModePicker" SelectedIndex="0" SelectionChanged="OnModeChanged" Padding="7">
         <ComboBoxItem Content="結構與分析" Tag="Analyze"/><ComboBoxItem Content="報告模式" Tag="Report"/>
         <ComboBoxItem Content="HTML 檔案" Tag="HtmlFile"/><ComboBoxItem Content="HTML 度量值" Tag="HtmlMeasure"/>
         <ComboBoxItem Content="Dashboard" Tag="Dashboard"/>
        </ComboBox>
       </StackPanel></ScrollViewer></TabItem>
       <TabItem Header="結果與匯出"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="4,16,4,0">
        <TextBlock x:Name="ResultTitle" Text="查詢結果與來源" FontSize="14" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBox x:Name="ResultDetails" Text="尚未執行數值查詢。" FontSize="12" IsReadOnly="True"
                 IsReadOnlyCaretVisible="True" TextWrapping="Wrap" AcceptsReturn="True" Background="Transparent"
                 BorderThickness="0" Padding="0" VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Disabled"
                 AutomationProperties.Name="回答與查詢結果，可選取並複製"/>
        <TextBlock Text="報告視覺" FontSize="12" Margin="0,18,0,7"/>
