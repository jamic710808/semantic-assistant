<Window x:Class="SemanticAssistant.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Semantic Assistant · 模型檢視與示範" Width="1200" Height="840" MinWidth="1040" MinHeight="720"
 Background="#F2F5FA" FontFamily="Microsoft JhengHei UI" Closing="OnClosing">
 <Grid Margin="24">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <Grid Margin="0,0,0,18">
   <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
   <StackPanel>
    <TextBlock Text="Semantic Assistant" FontSize="26" FontWeight="SemiBold" Foreground="#17324D"/>
    <TextBlock x:Name="SourceStatus" Foreground="#526477" Margin="0,6,0,0"/>
   </StackPanel>
   <WrapPanel Grid.Column="1" VerticalAlignment="Center">
    <Button x:Name="OpenFolderButton" Content="開啟 TMDL 資料夾" Click="OnOpenFolder"/>
    <Button x:Name="OpenExampleButton" Content="載入內附範例" Click="OnOpenExample"/>
    <Button x:Name="ReloadButton" Content="重新讀取" Click="OnReload" IsEnabled="False"/>
    <Button x:Name="LocalButton" Content="選取 Desktop" Click="OnOpenLocal"/>
    <Button x:Name="DemoButton" Content="返回示範" Click="OnReturnToDemo" Margin="0"/>
   </WrapPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="235"/><ColumnDefinition Width="*"/><ColumnDefinition Width="265"/></Grid.ColumnDefinitions>
   <Border Background="White" CornerRadius="12" Padding="18" Margin="0,0,14,0">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
     <StackPanel>
      <TextBlock x:Name="ModelName" FontWeight="Bold" FontSize="16"/>
      <TextBlock x:Name="ModelCounts" Foreground="#526477" Margin="0,4,0,12"/>
     </StackPanel>
     <StackPanel Grid.Row="1" Margin="0,0,0,10">
      <TextBlock Text="搜尋物件名稱" Foreground="#526477" FontSize="12" Margin="0,0,0,4"/>
      <TextBox x:Name="SearchInput" Padding="8" MaxLength="200" AutomationProperties.Name="搜尋模型物件"
       ToolTip="搜尋表、欄位、度量值或關係名稱" TextChanged="OnSearchChanged"/>
     </StackPanel>
     <TreeView x:Name="ModelTree" Grid.Row="2" BorderThickness="0" SelectedItemChanged="OnMetadataSelected"/>
     <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto"><StackPanel>
      <Separator Margin="0,4,0,12"/>
      <TextBlock Text="回合權限" FontWeight="Bold" Margin="0,0,0,10"/>
      <CheckBox x:Name="AllowQuery" Content="允許目前模型數值查詢" Margin="0,0,0,10"/>
      <CheckBox x:Name="AllowExport" Content="允許匯出本機 HTML" Margin="0,0,0,10"/>
      <CheckBox x:Name="AllowExternalTools" Content="允許當次AI提出已匯入工具呼叫" ToolTip="每次執行仍需預覽參數與明確同意" Margin="0,0,0,10"/>
      <TextBlock x:Name="PolicyHint" Foreground="#526477" FontSize="12"/>
      <TextBlock x:Name="AiProviderLabel" Text="AI：本機模擬" FontSize="12" Margin="0,12,0,4" TextWrapping="Wrap"/>
      <Button x:Name="AiConfigButton" Content="設定 AI 供應商" Click="OnAiConfig" Margin="0,0,0,4"/>
      <Button x:Name="AiDemoButton" Content="使用本機模擬 AI" Click="OnAiDemo" Margin="0"/>
      <Expander Header="更多來源與工具" Margin="0,8,0,0">
       <StackPanel>
        <Button x:Name="CloudButton" Content="登入 Power BI 雲端" Click="OnOpenCloud" Margin="0,0,0,4"/>
        <Button x:Name="CloudSignOutButton" Content="登出雲端並清除本機登入" Click="OnSignOutCloud" IsEnabled="False" Margin="0,0,0,4"/>
        <Button x:Name="McpButton" Content="MCP 外部工具" Click="OnOpenMcp" Margin="0,0,0,4"/>
      <TextBlock x:Name="ImportedToolsLabel" Text="已明確匯入：0 個外部工具" FontSize="12"/>
      <Button x:Name="ClearImportsButton" Content="清除已匯入工具並關閉程序" Click="OnClearImportedTools" Margin="0,4,0,8"/>
      <Button x:Name="SettingsButton" Content="本機執行預算" Click="OnSettings" Margin="0,4,0,0"/>
      <Button x:Name="HistoryButton" Content="本機歷史與保存政策" Click="OnHistory" Margin="0,4,0,0"/>

        <Button x:Name="WriteButton" Content="模型修改預覽" Click="OnOpenWriter" Margin="0"/>
        <Button x:Name="DashboardButton" Content="Dashboard 計畫" Click="OnOpenDashboard" Margin="0,4,0,0"/>
       </StackPanel>
      </Expander>
     </StackPanel></ScrollViewer>
    </Grid>
   </Border>
   <Border Grid.Column="1" Background="White" CornerRadius="12" Padding="18" Margin="0,0,14,0">
    <TabControl x:Name="ContentTabs" BorderThickness="0">
     <TabItem Header="示範對話" x:Name="ChatTab">
      <ScrollViewer x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" Margin="0,12,0,0">
       <TextBlock x:Name="Transcript" FontSize="14" LineHeight="24" Text="先輸入需求，或選取左側物件查看結構定義。"/>
      </ScrollViewer>
     </TabItem>
     <TabItem Header="模型詳情">
      <Grid Margin="0,12,0,0">
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
       <TextBlock x:Name="DetailTitle" FontSize="17" FontWeight="Bold" Margin="0,0,0,12"/>
       <TextBox x:Name="MetadataDetails" Grid.Row="1" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0"
        VerticalScrollBarVisibility="Auto" FontSize="14" Padding="0" Background="White"/>
      </Grid>
     </TabItem>
    </TabControl>
   </Border>
   <Border Grid.Column="2" Background="White" CornerRadius="12" Padding="18">
    <Grid>
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <TextBlock x:Name="ResultTitle" Text="查詢結果與來源" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><TextBlock x:Name="ResultDetails" Text="尚未執行數值查詢。" FontSize="13" LineHeight="23"/></ScrollViewer>
     <StackPanel Grid.Row="2">
      <TextBlock Text="報告視覺" FontSize="12" Margin="0,10,0,4"/>
      <ComboBox x:Name="ReportStylePicker" SelectedIndex="0">
       <ComboBoxItem Content="表格＋KPI＋長條圖"/><ComboBoxItem Content="表格＋KPI＋折線圖"/><ComboBoxItem Content="只顯示表格"/>
      </ComboBox>
      <Button x:Name="ExportButton" Content="匯出離線 HTML" Click="OnExport" IsEnabled="False" Margin="0,12,0,0"/>
      <Button x:Name="ProposalButton" Content="檢視AI Dashboard提案" Click="OnOpenDashboardProposal" IsEnabled="False" Margin="0,8,0,0"/>
     </StackPanel>
    </Grid>
   </Border>
  </Grid>
  <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="16" Margin="0,16,0,0">
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <ComboBox x:Name="ModePicker" SelectedIndex="0" Margin="0,0,12,0" VerticalContentAlignment="Center" SelectionChanged="OnModeChanged">
     <ComboBoxItem Content="結構與分析" Tag="Analyze"/><ComboBoxItem Content="報告模式" Tag="Report"/>
     <ComboBoxItem Content="HTML 檔案" Tag="HtmlFile"/><ComboBoxItem Content="HTML 度量值" Tag="HtmlMeasure"/>
     <ComboBoxItem Content="Dashboard" Tag="Dashboard"/>
    </ComboBox>
    <TextBox x:Name="MessageInput" Grid.Column="1" Text="介紹模型結構" Padding="10" VerticalContentAlignment="Center" MaxLength="4000" Margin="0,0,12,0"/>
    <Button x:Name="SendButton" Grid.Column="2" Content="送出" Click="OnSend"/>
    <Button x:Name="CancelButton" Grid.Column="3" Content="取消" Click="OnCancel" IsEnabled="False" Margin="0"/>
   </Grid>
  </Border>
 </Grid>
</Window>
