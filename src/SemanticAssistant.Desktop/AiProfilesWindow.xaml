<Window x:Class="SemanticAssistant.Desktop.AiProfilesWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AI 配置 · 模型管理" Width="882" Height="650" MinWidth="780" MinHeight="600"
 WindowStartupLocation="CenterOwner" FontFamily="Microsoft JhengHei UI" FontSize="12" Background="#F5EBF5">
 <Window.Resources>
  <Style x:Key="Action" TargetType="Button">
   <Setter Property="Background" Value="#007ED8"/><Setter Property="Foreground" Value="White"/>
   <Setter Property="Padding" Value="16,7"/><Setter Property="Margin" Value="0"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#254C70"/><Setter TargetName="Surface" Property="BorderThickness" Value="1"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Field" TargetType="TextBox">
   <Setter Property="Background" Value="#FAFCFF"/><Setter Property="BorderBrush" Value="#DCDFE9"/>
   <Setter Property="BorderThickness" Value="1"/><Setter Property="Padding" Value="11,4"/><Setter Property="Margin" Value="0,6,0,13"/><Setter Property="Height" Value="34"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}">
     <ScrollViewer x:Name="PART_ContentHost"/>
    </Border><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#1684D6"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBoxItem">
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Margin" Value="0,0,0,11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
    <Border x:Name="Card" Background="#EFF5FC" BorderBrush="#D7E4F2" BorderThickness="1" CornerRadius="13" Padding="13,11">
     <ContentPresenter/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#0086F0"/><Setter TargetName="Card" Property="Background" Value="#E7F2FF"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/></Trigger>
     <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="#0086F0"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </Window.Resources>
 <Border Margin="11" Background="#F9F8FC" CornerRadius="15" Padding="15">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel Margin="0,0,0,18">
    <Button x:Name="AddButton" DockPanel.Dock="Right" Content="＋ 新增模型" Style="{StaticResource Action}" Click="OnAdd"/>
    <TextBlock Text="AI 配置" FontWeight="SemiBold" FontSize="20" VerticalAlignment="Center"/>
   </DockPanel>
   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="280"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border CornerRadius="13" Background="#F0EBF8" BorderBrush="#EBE5F3" BorderThickness="1" Padding="13">
     <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <TextBlock Text="模型清單" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,13"/>
      <ListBox x:Name="ProfilesList" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionChanged="OnSelected" ScrollViewer.HorizontalScrollBarVisibility="Disabled"/>
      <TextBlock x:Name="ActiveSummary" Grid.Row="2" Foreground="#587393" TextWrapping="Wrap" FontSize="11" Margin="0,12,0,0"/>
     </Grid>
    </Border>
    <Border Grid.Column="2" CornerRadius="13" BorderBrush="#E4E8F2" BorderThickness="1" Padding="13">
     <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E9F2FF" Offset="0"/><GradientStop Color="#F2E6F5" Offset="1"/></LinearGradientBrush></Border.Background>
     <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
      <DockPanel Margin="0,0,0,12"><TextBlock x:Name="ActiveBadge" DockPanel.Dock="Right" Foreground="#007ED8" FontSize="11"/><TextBlock x:Name="EditorTitle" Text="新增模型" FontWeight="SemiBold" FontSize="14"/></DockPanel>
      <TextBlock Text="顯示名稱"/><TextBox x:Name="DisplayNameInput" Style="{StaticResource Field}" MaxLength="80" TextChanged="OnEdited" AutomationProperties.Name="模型顯示名稱"/>
      <TextBlock Text="API key"/>
      <PasswordBox x:Name="KeyInput" Height="34" Padding="11,4" Margin="0,6,0,6" MaxLength="2560" Background="#FAFCFF" BorderBrush="#DCDFE9" PasswordChanged="OnPasswordEdited" AutomationProperties.Name="API key，留白沿用既有 key">
       <PasswordBox.Template><ControlTemplate TargetType="PasswordBox">
        <Border x:Name="KeyFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="9" Padding="{TemplateBinding Padding}"><ScrollViewer x:Name="PART_ContentHost"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="KeyFrame" Property="BorderBrush" Value="#1684D6"/></Trigger></ControlTemplate.Triggers>
       </ControlTemplate></PasswordBox.Template>
      </PasswordBox>
      <TextBlock Text="留白沿用此模型已保存的 key；key 不會回填或寫入設定檔。" Foreground="#667A90" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,6"/>
      <TextBlock x:Name="KeyStatus" Foreground="#527A98" FontSize="10" Margin="0,0,0,6"/>
      <CheckBox x:Name="RemoveKey" Content="清除此模型的已保存 key（不需 key 的服務）" Margin="0,0,0,10" Checked="OnKeyOptionChanged" Unchecked="OnKeyOptionChanged"/>
      <TextBlock Text="端點 URL（完整 Chat Completions URL）"/><TextBox x:Name="EndpointInput" Style="{StaticResource Field}" MaxLength="2048" TextChanged="OnEdited" AutomationProperties.Name="完整 Chat Completions 端點"/>
      <TextBlock Text="模型名稱（Model Name）"/><TextBox x:Name="ModelInput" Style="{StaticResource Field}" MaxLength="128" TextChanged="OnEdited" AutomationProperties.Name="供應商模型名稱"/>
      <TextBlock Text="目前支援 Chat Completions 相容服務。保存與切換不會發出 AI 請求。" Foreground="#667A90" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,5"/>
     </StackPanel></ScrollViewer>
     <StackPanel Grid.Row="1" Margin="0,10,0,0">
      <WrapPanel>
       <Button x:Name="SaveButton" Content="保存設定" Style="{StaticResource Action}" Click="OnSave" Margin="0,0,9,8"/>
       <Button x:Name="ActivateButton" Content="設為目前使用" Style="{StaticResource Action}" Click="OnActivate" Margin="0,0,9,8"/>
       <Button x:Name="DeleteButton" Content="刪除模型" Style="{StaticResource Action}" Background="#AE5368" Click="OnDelete" Margin="0,0,0,8"/>
      </WrapPanel>
      <TextBlock x:Name="StatusText" Foreground="#416A8B" TextWrapping="Wrap" Margin="0,8,0,0"/>
     </StackPanel></Grid>
    </Border>
   </Grid>
   <DockPanel Grid.Row="2" Margin="0,12,0,0">
    <Button DockPanel.Dock="Right" Content="完成" Style="{StaticResource Action}" Click="OnDone"/>
    <TextBlock Text="已保存的模型會保留；按送出即以目前模型分析提問與已允許的資料。" Foreground="#778398" FontSize="11" VerticalAlignment="Center"/>
   </DockPanel>
  </Grid>
 </Border>
</Window>
